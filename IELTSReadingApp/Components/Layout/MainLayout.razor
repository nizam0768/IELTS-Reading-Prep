@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center w-100">
                <span>IELTS Academic Reading Practice</span>
                <div>
                    <a href="/" class="text-white text-decoration-none me-3">
                        <i class="fas fa-home me-1"></i>Home
                    </a>
                    <a href="https://www.ielts.org/for-test-takers/test-format/academic/reading" 
                       target="_blank" class="text-white text-decoration-none">
                        <i class="fas fa-external-link-alt me-1"></i>Official IELTS Info
                    </a>
                </div>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
