@using IELTSPracticeApp.Data.Models

<div class="text-input-question">
    <div class="input-container">
        <div class="form-floating">
            <input type="text" 
                   class="form-control @(IsOverWordLimit ? "is-invalid" : "")" 
                   id="answer_@Question.Id"
                   placeholder="Enter your answer"
                   value="@currentAnswer"
                   @oninput="HandleInputChange"
                   @onblur="HandleBlur" />
            <label for="answer_@Question.Id">Your Answer</label>
        </div>
        
        @if (Question.WordLimit.HasValue)
        {
            <div class="word-limit-info mt-2">
                <small class="@(IsOverWordLimit ? "text-danger" : "text-muted")">
                    <i class="fas fa-info-circle"></i>
                    Word count: @currentWordCount / @Question.WordLimit maximum
                    @if (IsOverWordLimit)
                    {
                        <span class="ms-1">⚠️ Exceeds word limit!</span>
                    }
                </small>
            </div>
        }
        
        @if (IsOverWordLimit)
        {
            <div class="alert alert-warning mt-2">
                <small>
                    <i class="fas fa-exclamation-triangle"></i>
                    Your answer exceeds the word limit. Please shorten it to @Question.WordLimit words or fewer.
                </small>
            </div>
        }
    </div>

    @if (ShowHelpText)
    {
        <div class="help-text mt-3">
            <small class="text-muted">
                @switch (Question.QuestionType)
                {
                    case QuestionType.SentenceCompletion:
                        <span><i class="fas fa-lightbulb"></i> Complete the sentence using words from the passage. Pay attention to grammar and word forms.</span>
                        break;
                    case QuestionType.SummaryCompletion:
                        <span><i class="fas fa-lightbulb"></i> Use words from the passage to complete the summary. Maintain the original meaning.</span>
                        break;
                    case QuestionType.DiagramLabelCompletion:
                        <span><i class="fas fa-lightbulb"></i> Label the diagram using words from the passage. Look for technical terms and specific details.</span>
                        break;
                    case QuestionType.ShortAnswerQuestions:
                        <span><i class="fas fa-lightbulb"></i> Answer the question using words from the passage. Be precise and factual.</span>
                        break;
                }
            </small>
        </div>
    }
</div>

@code {
    [Parameter] public Question Question { get; set; } = null!;
    [Parameter] public string UserAnswer { get; set; } = string.Empty;
    [Parameter] public EventCallback<(int QuestionId, string Answer)> OnAnswerChanged { get; set; }
    [Parameter] public bool ShowHelpText { get; set; } = true;

    private string currentAnswer = string.Empty;
    private int currentWordCount = 0;
    private bool IsOverWordLimit => Question.WordLimit.HasValue && currentWordCount > Question.WordLimit.Value;

    protected override void OnParametersSet()
    {
        currentAnswer = UserAnswer;
        UpdateWordCount();
    }

    private void HandleInputChange(ChangeEventArgs e)
    {
        currentAnswer = e.Value?.ToString() ?? string.Empty;
        UpdateWordCount();
    }

    private async Task HandleBlur()
    {
        await OnAnswerChanged.InvokeAsync((Question.Id, currentAnswer));
    }

    private void UpdateWordCount()
    {
        if (string.IsNullOrWhiteSpace(currentAnswer))
        {
            currentWordCount = 0;
        }
        else
        {
            currentWordCount = currentAnswer.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
        }
        StateHasChanged();
    }
}

<style>
    .text-input-question {
        margin-top: 1rem;
    }

    .input-container {
        position: relative;
    }

    .form-floating {
        position: relative;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 0.5rem;
        padding: 1rem 0.75rem 0.5rem;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    .form-control.is-invalid {
        border-color: #dc3545;
    }

    .form-control.is-invalid:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
    }

    .form-floating > label {
        padding: 1rem 0.75rem;
        color: #6c757d;
        font-size: 0.875rem;
    }

    .word-limit-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .help-text {
        padding: 0.75rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        border-left: 4px solid #28a745;
    }

    .alert-warning {
        padding: 0.5rem 0.75rem;
        margin-bottom: 0;
        font-size: 0.875rem;
    }

    @media (max-width: 768px) {
        .form-control {
            font-size: 16px; /* Prevents zoom on iOS */
        }
    }
</style>