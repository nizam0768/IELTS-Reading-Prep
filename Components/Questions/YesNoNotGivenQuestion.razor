@using IELTSPracticeApp.Data.Models

<div class="yes-no-not-given-question">
    <div class="options-container">
        <div class="form-check option-item @(UserAnswer.ToLower() == "yes" ? "selected" : "")">
            <input class="form-check-input" 
                   type="radio" 
                   name="question_@Question.Id" 
                   id="yes_@Question.Id"
                   value="yes"
                   checked="@(UserAnswer.ToLower() == "yes")"
                   @onchange="@(async (e) => await HandleAnswerChange("yes"))" />
            <label class="form-check-label" for="yes_@Question.Id">
                <span class="option-indicator yes-indicator">✓</span>
                <span class="option-text">YES</span>
            </label>
        </div>

        <div class="form-check option-item @(UserAnswer.ToLower() == "no" ? "selected" : "")">
            <input class="form-check-input" 
                   type="radio" 
                   name="question_@Question.Id" 
                   id="no_@Question.Id"
                   value="no"
                   checked="@(UserAnswer.ToLower() == "no")"
                   @onchange="@(async (e) => await HandleAnswerChange("no"))" />
            <label class="form-check-label" for="no_@Question.Id">
                <span class="option-indicator no-indicator">✗</span>
                <span class="option-text">NO</span>
            </label>
        </div>

        <div class="form-check option-item @(UserAnswer.ToLower() == "not given" ? "selected" : "")">
            <input class="form-check-input" 
                   type="radio" 
                   name="question_@Question.Id" 
                   id="notgiven_@Question.Id"
                   value="not given"
                   checked="@(UserAnswer.ToLower() == "not given")"
                   @onchange="@(async (e) => await HandleAnswerChange("not given"))" />
            <label class="form-check-label" for="notgiven_@Question.Id">
                <span class="option-indicator not-given-indicator">?</span>
                <span class="option-text">NOT GIVEN</span>
            </label>
        </div>
    </div>
    
    <div class="help-text mt-3">
        <small class="text-muted">
            <strong>YES:</strong> The statement agrees with the writer's views or claims.<br>
            <strong>NO:</strong> The statement contradicts the writer's views or claims.<br>
            <strong>NOT GIVEN:</strong> There is no information about the writer's views on this.
        </small>
    </div>
</div>

@code {
    [Parameter] public Question Question { get; set; } = null!;
    [Parameter] public string UserAnswer { get; set; } = string.Empty;
    [Parameter] public EventCallback<(int QuestionId, string Answer)> OnAnswerChanged { get; set; }

    private async Task HandleAnswerChange(string selectedValue)
    {
        await OnAnswerChanged.InvokeAsync((Question.Id, selectedValue));
    }
}

<style>
    .yes-no-not-given-question {
        margin-top: 1rem;
    }

    .options-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .option-item {
        padding: 1rem;
        border: 2px solid #e9ecef;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
        cursor: pointer;
        position: relative;
    }

    .option-item:hover {
        border-color: #6c757d;
        background-color: #f8f9fa;
    }

    .option-item.selected {
        background-color: #e7f3ff;
    }

    .option-item:has(.form-check-input:checked) {
        border-color: #0d6efd;
        background-color: #e7f3ff;
    }

    .form-check-input {
        margin-top: 0.125rem;
    }

    .form-check-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        width: 100%;
        font-weight: 500;
    }

    .option-indicator {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.1rem;
    }

    .yes-indicator {
        background-color: #d4edda;
        color: #155724;
        border: 2px solid #c3e6cb;
    }

    .no-indicator {
        background-color: #f8d7da;
        color: #721c24;
        border: 2px solid #f5c6cb;
    }

    .not-given-indicator {
        background-color: #fff3cd;
        color: #856404;
        border: 2px solid #ffeaa7;
    }

    .option-item:has(.form-check-input:checked) .yes-indicator {
        background-color: #28a745;
        color: white;
        border-color: #28a745;
    }

    .option-item:has(.form-check-input:checked) .no-indicator {
        background-color: #dc3545;
        color: white;
        border-color: #dc3545;
    }

    .option-item:has(.form-check-input:checked) .not-given-indicator {
        background-color: #ffc107;
        color: #212529;
        border-color: #ffc107;
    }

    .option-text {
        font-size: 1rem;
        letter-spacing: 0.5px;
    }

    .help-text {
        padding: 0.75rem;
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        border-left: 4px solid #17a2b8;
    }
</style>